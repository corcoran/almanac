{
  "name": "almanac",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dev:api": "pnpm --filter @almanac/api dev",
    "dev:mcp": "pnpm --filter @almanac/mcp dev",
    "dev:web": "pnpm --filter @almanac/web dev",
    "dev:all": "concurrently -k -n api,mcp,web -c blue,magenta,green \"pnpm dev:api\" \"pnpm dev:mcp\" \"pnpm dev:web\"",
    "dev": "pnpm dev:all"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "concurrently": "^10.0.3",
    "playwright-core": "^1.62.1",
    "typescript": "^6.0.3",
    "vitepress": "1.6.4",
    "vitest": "^4.1.8"
  }
}
