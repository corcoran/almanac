# ──────────────────────────────────────────────────────────────────────
# Local dev (pnpm dev:*). These values are also fine for `docker compose
# up` — the compose file overrides ALMANAC_API_HOST → 0.0.0.0 and
# ALMANAC_DB_PATH → /data/almanac.sqlite inside the container.
# ──────────────────────────────────────────────────────────────────────
ALMANAC_DB_PATH=./data/almanac.sqlite
ALMANAC_API_PORT=3001
ALMANAC_API_HOST=127.0.0.1
# Base URL the MCP package uses to call the API. Compose overrides this
# to http://almanac-api:3001 on the almanac-mcp service. The Vite dev
# proxy also reads this when ALMANAC_API_URL is set in the shell — so
# running side-by-side with another stack (e.g. prod on :3001 and this
# worktree on :3002) just means setting ALMANAC_API_URL=http://127.0.0.1:3002.
ALMANAC_API_URL=http://127.0.0.1:3001

# Port the Vite dev server binds. Default 5173. Set when running
# side-by-side with another dev web (e.g. prod on :5173, worktree on :5174).
# ALMANAC_WEB_PORT=5173

# Trust the X-Forwarded-Email header from oauth2-proxy (production) or from
# the Vite dev proxy (local dev). REQUIRED to be "true" for the auth
# middleware to accept that path. Leave false in any deployment where
# nothing is in front of the API.
ALMANAC_TRUST_PROXY_HEADERS=true

# Pino log level override for the API. One of: fatal|error|warn|info|debug|
# trace|silent. Leave unset to use the built-in default (debug in dev, info
# in prod). Set to debug to surface the health/version probes that are
# normally demoted out of the info stream.
# ALMANAC_LOG_LEVEL=debug

# Email injected into X-Forwarded-Email by the Vite dev proxy. Mirrors what
# oauth2-proxy emits in prod. The API auto-provisions a user row for this
# email on first request.
ALMANAC_DEV_EMAIL=you@example.com

# Transport for the MCP server: "stdio" (Claude Code local dev), "http"
# (Streamable HTTP, the new default for remote deploys), or "sse" (legacy,
# deprecated — emits a startup warning).
ALMANAC_MCP_TRANSPORT=stdio

# HTTP transport fields. Ignored when ALMANAC_MCP_TRANSPORT=stdio.
ALMANAC_MCP_PORT=3030
ALMANAC_MCP_HOST=127.0.0.1
# Bearer token the MCP server uses to authenticate API calls. Only consumed
# when ALMANAC_MCP_TRANSPORT=stdio — for http/sse, each client connection
# brings its own bearer in the Authorization header (validated by the API
# against personal_access_tokens). Mint a PAT via the web Settings UI and
# paste the cleartext here.
ALMANAC_MCP_CLIENT_TOKEN=change-me-dev

# ──────────────────────────────────────────────────────────────────────
# LLM meal-chat (optional). Gates the conversational meal-logging endpoint.
# Leave ALMANAC_LLM_ENABLED=false (the default) to disable the feature
# entirely; manual meal logging never touches any of this.
#
# PROD (docker-compose): the almanac-api service already passes these through
# from this host .env (see docker-compose.yml). To turn the feature on in prod
# you ALSO need: (1) the per-user flag llm_logging_enabled=1 (admin API/MCP tool,
# or a one-time `UPDATE users SET llm_logging_enabled=1 WHERE email='...'`), and
# (2) web search enabled for your org in the Anthropic Console (Settings →
# Privacy). Without an API key the AI surface stays hidden (llm_available=false).
# ──────────────────────────────────────────────────────────────────────
# ALMANAC_LLM_ENABLED=true
# ALMANAC_LLM_PROVIDER=anthropic
# ALMANAC_LLM_MODEL=claude-haiku-4-5
# Model for the AI INSIGHTS coach (separate from the meal parser above). The
# coach does harder reasoning, so it defaults to a stronger model; meal chat
# stays on ALMANAC_LLM_MODEL. Defaults to claude-sonnet-4-6 if unset.
# ALMANAC_LLM_INSIGHTS_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...
#
# ALMANAC_LLM_DEFAULT_DAILY_TOKEN_LIMIT — the SOFT daily token limit
# (advisory; drives the "~N logs left" indicator and warnings; NEVER blocks
# the chat). Per-user overridable via the admin API. Unset = no soft limit.
# Default below is ~30000 ≈ 15 meal logs/day (≈2000 tokens each).
ALMANAC_LLM_DEFAULT_DAILY_TOKEN_LIMIT=30000
#
# ALMANAC_LLM_HARD_DAILY_TOKEN_CAP — the HARD daily token ceiling (a runaway
# circuit-breaker). When a user's daily input+output tokens reach it, the
# chat endpoint returns 429 and skips the model. Optional; unset = no hard
# cap. Manual meal logging is never affected by either limit.
# ALMANAC_LLM_HARD_DAILY_TOKEN_CAP=100000
# Flat token charge per web search against the daily AI budget when the user has
# no recent search history to average (default 2500).
ALMANAC_LLM_TOKENS_PER_SEARCH=2500
# Max web searches per user-local day. At the cap, search is disabled for the
# turn but the meal still logs. Default 8/day; unset = uncapped.
ALMANAC_LLM_HARD_DAILY_SEARCH_CAP=8

# ──────────────────────────────────────────────────────────────────────
# DEPLOY-ONLY: which GHCR namespace docker-compose pulls images from.
# Defaults to the upstream project's namespace. If you fork this repo and
# publish your own images (the release workflow builds to your account's
# GHCR automatically), set this to your GitHub username/org.
# ──────────────────────────────────────────────────────────────────────
# ALMANAC_IMAGE_OWNER=corcoran

# ──────────────────────────────────────────────────────────────────────
# DEPLOY-ONLY: oauth2-proxy variables. Required when running docker-compose.
# Not consumed by `pnpm dev` directly. Generate the cookie secret with:
#   python -c 'import secrets,string;print("".join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))'
# ──────────────────────────────────────────────────────────────────────
OAUTH2_PROXY_CLIENT_ID=__from_google_oauth_console__
OAUTH2_PROXY_CLIENT_SECRET=__from_google_oauth_console__
OAUTH2_PROXY_COOKIE_SECRET=__32_random_url_safe_bytes__
OAUTH2_PROXY_REDIRECT_URL=https://almanac.yourdomain.com/oauth2/callback

# ──────────────────────────────────────────────────────────────────────
# MCP OAuth 2.1: Lets Claude mobile / ChatGPT connect via the standard
# MCP OAuth discovery flow. Uses the same Google OAuth credentials as
# oauth2-proxy. Leave blank to disable (PAT-only mode).
#
# IMPORTANT: You must also register the callback URL in Google Cloud Console:
#   https://almanac.yourdomain.com/oauth/google/callback
# ──────────────────────────────────────────────────────────────────────
ALMANAC_MCP_OAUTH_CLIENT_ID=${OAUTH2_PROXY_CLIENT_ID}
ALMANAC_MCP_OAUTH_CLIENT_SECRET=${OAUTH2_PROXY_CLIENT_SECRET}
ALMANAC_MCP_PUBLIC_URL=https://almanac.yourdomain.com
# Email allowlist — file path (one email per line) or comma-separated.
# Shared by the API (user auto-provisioning) and MCP (OAuth flow).
# oauth2-proxy has its own --authenticated-emails-file pointing at the
# same file. Empty = allow any authenticated email.
ALMANAC_ALLOWED_EMAILS=/emails/allowed-users.txt

# ──────────────────────────────────────────────────────────────────────
# DEPLOY-ONLY: watchtower auto-deploy email notifications. The watchtower
# service (docker-compose.yml) emails on updates/errors via shoutrrr SMTP.
# Set WATCHTOWER_EMAIL_TO to turn notifications on; leave it blank and
# watchtower runs silently. The rest have sensible defaults.
#
# WATCHTOWER_EMAIL_HELO is the HELO/EHLO hostname sent to the SMTP server.
# It MUST be an FQDN — a strict postfix rejects the shoutrrr default
# ("localhost") with "504 5.5.2 ... need fully-qualified hostname".
# ──────────────────────────────────────────────────────────────────────
WATCHTOWER_EMAIL_TO=
# WATCHTOWER_EMAIL_FROM=watchtower@almanac.example.com
# WATCHTOWER_EMAIL_SERVER=mail.example.com
# WATCHTOWER_EMAIL_PORT=25
# WATCHTOWER_EMAIL_HELO=almanac.example.com
