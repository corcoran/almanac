# Almanac configuration. Copy to .env and edit.
# Full reference: https://almanac-fitness.com/guide/configuration
#
# Uncommented values below are the defaults. Commented lines are optional.

# ─── Core ─────────────────────────────────────────────────────────────
# Compose overrides ALMANAC_API_HOST=0.0.0.0 and ALMANAC_DB_PATH inside
# the container.
ALMANAC_DB_PATH=./data/almanac.sqlite
ALMANAC_API_PORT=3001
ALMANAC_API_HOST=127.0.0.1
ALMANAC_API_URL=http://127.0.0.1:3001

# Trust X-Forwarded-Email from oauth2-proxy or the Vite dev proxy. Must be
# true for that auth path; false if nothing sits in front of the API.
ALMANAC_TRUST_PROXY_HEADERS=true

# Email the Vite dev proxy injects. Auto-provisions a user on first request.
ALMANAC_DEV_EMAIL=you@example.com

# Vite dev server port (default 5173).
# ALMANAC_WEB_PORT=5173

# fatal|error|warn|info|debug|trace|silent. Default: debug in dev, info in prod.
# ALMANAC_LOG_LEVEL=debug

# ─── MCP server ───────────────────────────────────────────────────────
# stdio (local Claude Code) | http (remote deploys) | sse (deprecated)
ALMANAC_MCP_TRANSPORT=stdio
ALMANAC_MCP_PORT=3030
ALMANAC_MCP_HOST=127.0.0.1

# PAT used for API calls. Only read when transport=stdio; http/sse take a
# bearer per connection. Mint one in web Settings.
ALMANAC_MCP_CLIENT_TOKEN=change-me-dev

# ─── AI surfaces (optional) ───────────────────────────────────────────
# Off unless ALMANAC_LLM_ENABLED=true AND a key is set AND the per-user
# llm_logging_enabled flag is on. Manual logging never uses any of this.
# See https://almanac-fitness.com/guide/configuration#ai
# ALMANAC_LLM_ENABLED=true
# ALMANAC_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Meal parser (cheap) and insights coach (stronger) use separate models.
# ALMANAC_LLM_MODEL=claude-haiku-4-5
# ALMANAC_LLM_INSIGHTS_MODEL=claude-sonnet-4-6

# Soft daily token limit — advisory only, drives the "~N logs left" hint.
ALMANAC_LLM_DEFAULT_DAILY_TOKEN_LIMIT=30000
# Hard daily ceiling — returns 429 past this. Unset = uncapped.
# ALMANAC_LLM_HARD_DAILY_TOKEN_CAP=100000
ALMANAC_LLM_TOKENS_PER_SEARCH=2500
ALMANAC_LLM_HARD_DAILY_SEARCH_CAP=8

# ─── Deploy: images ───────────────────────────────────────────────────
# GHCR namespace to pull from. Set to your GitHub user/org if you forked.
# ALMANAC_IMAGE_OWNER=corcoran

# ─── Deploy: browser sign-in (oauth2-proxy) ───────────────────────────
# Generate the cookie secret with:
#   python -c 'import secrets,string;print("".join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))'
OAUTH2_PROXY_CLIENT_ID=__from_your_oauth_provider__
OAUTH2_PROXY_CLIENT_SECRET=__from_your_oauth_provider__
OAUTH2_PROXY_COOKIE_SECRET=__32_random_url_safe_bytes__
OAUTH2_PROXY_REDIRECT_URL=https://almanac.yourdomain.com/oauth2/callback

# google (default) | github | oidc — see
# https://almanac-fitness.com/guide/authentication
# OAUTH2_PROXY_PROVIDER=google

# Required when provider=oidc. Ignored otherwise.
# OAUTH2_PROXY_OIDC_ISSUER_URL=https://kc.yourdomain.com/realms/almanac

# Skip the "Sign in with X" interstitial. Default true.
# OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true

# ─── Deploy: MCP OAuth 2.1 (Claude mobile / ChatGPT) ──────────────────
# Set all four together, or leave all blank for PAT-only mode.
#
# Register this callback with your provider:
#   https://almanac.yourdomain.com/oauth/callback
ALMANAC_MCP_OIDC_ISSUER=https://accounts.google.com
ALMANAC_MCP_PUBLIC_URL=https://almanac.yourdomain.com

# Compose defaults these to the OAUTH2_PROXY_* values above. Set explicitly
# when your provider needs a separate client (Keycloak uses two).
ALMANAC_MCP_OAUTH_CLIENT_ID=${OAUTH2_PROXY_CLIENT_ID}
ALMANAC_MCP_OAUTH_CLIENT_SECRET=${OAUTH2_PROXY_CLIENT_SECRET}

# Default /oauth/callback.
# ALMANAC_MCP_OAUTH_CALLBACK_PATH=/oauth/callback

# File path or comma-separated list. Empty = any authenticated email.
ALMANAC_ALLOWED_EMAILS=/emails/allowed-users.txt

# ─── Deploy: self-hosted Keycloak (optional) ──────────────────────────
# Only read by `docker compose --profile keycloak up -d`. Compose does NOT
# default the passwords — unset, Keycloak boots with a blank admin password.
# KEYCLOAK_ADMIN_PASSWORD=__32_random_chars__
# KEYCLOAK_DB_PASSWORD=__32_random_chars__
# KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_HOSTNAME=https://keycloak.yourdomain.com

# ─── Deploy: watchtower notifications ─────────────────────────────────
# Set WATCHTOWER_EMAIL_TO to enable; blank runs silently.
# WATCHTOWER_EMAIL_HELO must be an FQDN — strict postfix rejects "localhost".
WATCHTOWER_EMAIL_TO=
# WATCHTOWER_EMAIL_FROM=watchtower@almanac.example.com
# WATCHTOWER_EMAIL_SERVER=mail.example.com
# WATCHTOWER_EMAIL_PORT=25
# WATCHTOWER_EMAIL_HELO=almanac.example.com
